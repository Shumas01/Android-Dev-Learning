<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView android:text="Reset Password" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/reset_email" android:hint="Enter Email" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/reset_new_pass" android:hint="New Password" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btn_reset_confirm" android:text="Update Password" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>